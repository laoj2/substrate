new file mode 100755
index 000000000..fb16aeace
--- /dev/null
+++ b/cmd/ateapi/internal/scheduling/schedsim/gke-run-cell.sh
@@ -0,0 +1,106 @@
+#!/usr/bin/env bash
+# Copyright 2026 The Agent Substrate Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# EXPERIMENT ONLY. Runs one cell on the cluster of the current kubectl
+# context: sets the policy on ate-api-server, follows its logs for the whole
+# run so log rotation cannot drop retry, detach or crash lines, drives the
+# pattern, and appends to OUT/retries.csv.
+#
+# usage: gke-run-cell.sh SCENARIO ATESPACE PATTERN POLICY SEED
+#   gke-run-cell.sh g-gke8 cell-1 ramp-down prefixsat:1:0.2 1
+
+set -o errexit -o nounset -o pipefail
+
+scenario="$1" atespace="$2" pattern="$3" policy="$4" seed="$5"
+OUT="${OUT:-cmd/ateapi/internal/scheduling/schedsim/gke-results/phase-b}"
+BIN="${BIN:-bin/schedsim}"
+KUBECONFIG_PATH="${KUBECONFIG:-${HOME}/.kube/config}"
+mkdir -p "${OUT}"
+
+echo "target context: $(kubectl config current-context)"
+current="$(kubectl get deploy ate-api-server -n ate-system \
+  -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name=="ATE_API_SCHEDULING_POLICY")].value}')"
+changed=no
+if [[ "${current}" != "${policy}" ]]; then
+  kubectl set env deploy/ate-api-server -n ate-system -c ate-api-server "ATE_API_SCHEDULING_POLICY=${policy}"
+  changed=yes
+fi
+kubectl rollout status deploy/ate-api-server -n ate-system --timeout=300s
+
+# Old pods linger while they shut down. Wait so nothing dials or follows them.
+want="$(kubectl get deploy ate-api-server -n ate-system -o jsonpath='{.spec.replicas}')"
+until [[ "$(kubectl get pods -n ate-system -l app=ate-api-server --no-headers | wc -l | tr -d ' ')" == "${want}" ]]; do
+  sleep 2
+done
+sleep 3
+
+# objectstore-plugin's exchange client keeps a channel to the headless
+# svc/api. After the rollout it holds the old pods' IPs, and the first snapshot
+# transfer on each node waits out grpc-go's 20s minConnectTimeout before it
+# re-resolves. Restart atelet, which carries the plugin, so no cell pays that.
+if [[ "${changed}" == "yes" ]]; then
+  kubectl rollout restart ds/atelet -n ate-system
+  kubectl rollout status ds/atelet -n ate-system --timeout=900s
+  pool_want="$(kubectl get workerpool pool -n benchmark-workloads -o jsonpath='{.spec.replicas}')"
+  kubectl wait --for=jsonpath='{.status.readyReplicas}'="${pool_want}" workerpool/pool -n benchmark-workloads --timeout=600s
+fi
+
+# After a change every new pod must have logged the policy at startup. An
+# unchanged pod is not checked: its startup lines may have rotated away.
+if [[ "${changed}" == "yes" ]]; then
+  for pod in $(kubectl get pods -n ate-system -l app=ate-api-server -o name); do
+    line="$(kubectl logs -n ate-system "${pod}" -c ate-api-server --tail=-1 | grep '"msg":"scheduling policy"' || true)"
+    [[ -n "${line}" ]] || { echo "${pod} did not log its scheduling policy" >&2; exit 1; }
+    echo "${line}"
+  done
+fi
+
+tag="${pattern}_${policy//:/-}_${seed}_${atespace}"
+pids=()
+for pod in $(kubectl get pods -n ate-system -l app=ate-api-server -o name); do
+  kubectl logs -f -n ate-system "${pod}" -c ate-api-server --since=1s \
+    > >(grep --line-buffered -e 'schedexp assignment retry' -e 'Detached actor from its full node' -e '"Actor crashed"' \
+      >>"${OUT}/events_${tag}_${pod##*/}.log") 2>/dev/null &
+  pids+=("$!")
+done
+
+restarts() {
+  kubectl get pods -n ate-system -o jsonpath='{range .items[*]}{range .status.containerStatuses[*]}{.restartCount}{"\n"}{end}{end}' \
+    | awk '{n += $1} END {print n + 0}'
+}
+restarts_before="$(restarts)"
+t_start="$(date +%s)"
+
+"${BIN}" -kind -kubeconfig "${KUBECONFIG_PATH}" -scenario "${scenario}" -pattern "${pattern}" \
+  -policy "${policy}" -atespace "${atespace}" -seed "${seed}" -out "${OUT}" 2>&1 | tee -a "${OUT}/driver.log"
+
+t_end="$(date +%s)"
+# A follower that ended early means the counts are short.
+stream_ok=yes
+for p in "${pids[@]}"; do
+  if ! kill -0 "${p}" 2>/dev/null; then
+    stream_ok=no
+  fi
+  kill "${p}" 2>/dev/null || true
+done
+sleep 1
+restarted=$(( $(restarts) - restarts_before ))
+
+count() { cat "${OUT}"/events_"${tag}"_*.log 2>/dev/null | grep -c -e "$1" || true; }
+if [[ ! -f "${OUT}/retries.csv" ]]; then
+  echo "scenario,pattern,policy,seed,atespace,filled_up,version_conflict,detaches,crashes_log,stream_ok,ate_system_restarts,t_start,t_end" >"${OUT}/retries.csv"
+fi
+echo "${scenario},${pattern},${policy},${seed},${atespace},$(count '"reason":"filled_up"'),$(count '"reason":"version_conflict"'),$(count 'Detached actor from its full node'),$(count '"Actor crashed"'),${stream_ok},${restarted},${t_start},${t_end}" >>"${OUT}/retries.csv"
+tail -1 "${OUT}/retries.csv"
diff --git a/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/phase-b.sh b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/phase-b.sh
new file mode 100755
index 000000000..9bacd0574
--- /dev/null
+++ b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/phase-b.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Phase B orchestrator: two shuffled passes over ramp-down/burst x 3 policies.
+# Each run gets a fresh WorkerPool and a fresh atespace population.
+# usage: [SCENARIO=g-gke8] [PREFIX=cell] [OUT=dir] phase-b.sh [START_INDEX]
+set -o nounset -o pipefail
+
+G="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+REPO="$(git -C "${G}" rev-parse --show-toplevel)"
+SCENARIO="${SCENARIO:-g-gke8}"
+PREFIX="${PREFIX:-cell}"
+export OUT="${OUT:-${G}/phase-b}"
+mkdir -p "${OUT}"
+cd "${REPO}"
+# shellcheck disable=SC1091
+source /usr/local/google/home/luizaoj/go/src/substrate-gke/.ate-dev-env.sh
+# Pin every kubectl, kubectl-ate and driver call to sched-exp, so a context
+# switch elsewhere cannot redirect a cell to another cluster.
+export KUBECONFIG="${G}/kubeconfig-sched-exp"
+[[ "$(kubectl config current-context)" == "${KUBECTL_CONTEXT}" ]] || { echo "kubeconfig is not ${KUBECTL_CONTEXT}" >&2; exit 1; }
+
+start="${1:-1}"
+# CELLS_FILE lists "idx pattern policy seed" lines to run instead of the two passes.
+# Fixed shuffle so a restart resumes the same order.
+if [[ -n "${CELLS_FILE:-}" ]]; then
+  mapfile -t cells <"${CELLS_FILE}"
+else
+mapfile -t cells < <(python3 - <<'EOF'
+import itertools, random
+combos = list(itertools.product(["ramp-down", "burst"], ["p2c", "bestofd:3", "prefixsat:1:0.2"]))
+out = []
+for seed in (1, 2):
+    c = combos[:]
+    random.Random(100 + seed).shuffle(c)
+    out += [f"{p} {pol} {seed}" for p, pol in c]
+for i, x in enumerate(out, 1):
+    print(f"{i:02d} {x}")
+EOF
+)
+fi
+printf '%s\n' "${cells[@]}" >> "${OUT}/order.txt"
+
+for line in "${cells[@]}"; do
+  read -r idx pattern policy seed <<<"${line}"
+  (( 10#${idx} < start )) && continue
+  atespace="${PREFIX}-${idx}"
+  echo "=== $(date -Is) ${SCENARIO} cell ${idx}: ${pattern} ${policy} seed ${seed} atespace ${atespace}" | tee -a "${OUT}/phase-b.log"
+  if ! cmd/ateapi/internal/scheduling/schedsim/gke-setup.sh "${SCENARIO}" "${atespace}" 24 2 4160Mi 2>&1 \
+      | grep -v -e "pushed blob" -e "existing blob" -e "existing manifest" -e "token-file" >>"${OUT}/setup.log"; then
+    echo "setup failed for cell ${idx}" | tee -a "${OUT}/phase-b.log"
+    continue
+  fi
+  if ! cmd/ateapi/internal/scheduling/schedsim/gke-run-cell.sh "${SCENARIO}" "${atespace}" "${pattern}" "${policy}" "${seed}" 2>&1 \
+      | grep -v "token-file" >>"${OUT}/cells.log"; then
+    echo "run failed for cell ${idx}" | tee -a "${OUT}/phase-b.log"
+  fi
+  tail -1 "${OUT}/retries.csv" | tee -a "${OUT}/phase-b.log"
+  tail -1 "${OUT}/runs.csv" | tee -a "${OUT}/phase-b.log"
+  kubectl port-forward -n benchmarking svc/prometheus 19090:9090 >/dev/null 2>&1 &
+  pf=$!
+  for _ in $(seq 30); do curl -sf localhost:19090/-/ready >/dev/null && break; sleep 1; done
+  python3 "${G}/tools/collect_metrics.py" "${OUT}" >>"${OUT}/phase-b.log" 2>&1 || echo "metrics failed for cell ${idx}" | tee -a "${OUT}/phase-b.log"
+  kill "${pf}" 2>/dev/null || true
+done
+echo "=== $(date -Is) phase B done" | tee -a "${OUT}/phase-b.log"
diff --git a/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/collect_metrics.py b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/collect_metrics.py
new file mode 100644
index 000000000..7e3ba3d5d
--- /dev/null
+++ b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/collect_metrics.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Collects per-cell server metrics from the in-cluster Prometheus.
+
+For each row of OUT/retries.csv it evaluates instant queries at t_end over the
+window [t_start, t_end] and appends one row per cell to OUT/metrics.csv.
+
+usage: collect_metrics.py OUT_DIR [PROM_URL]
+"""
+import csv
+import json
+import math
+import os
+import sys
+import urllib.parse
+import urllib.request
+
+out = sys.argv[1]
+prom = sys.argv[2] if len(sys.argv) > 2 else "http://localhost:19090"
+
+
+def q(expr, t):
+    url = f"{prom}/api/v1/query?" + urllib.parse.urlencode({"query": expr, "time": t})
+    with urllib.request.urlopen(url, timeout=30) as r:
+        res = json.load(r)
+    if res.get("status") != "success":
+        raise RuntimeError(f"{expr}: {res}")
+    v = res["data"]["result"]
+    if not v:
+        return float("nan")
+    return float(v[0]["value"][1])
+
+
+def delta(sel, t0, t1, by="le"):
+    """sum by(by)(sel) at t1 minus at t0, treating series born in the window as 0 at t0."""
+    return (f"(sum by ({by}) ({sel}) - (sum by ({by}) ({sel} @ {t0}) "
+            f"or sum by ({by}) ({sel}) * 0))")
+
+
+def hq(phi, sel, t0, t1):
+    return q(f"histogram_quantile({phi}, {delta(sel, t0, t1)})", t1)
+
+
+def count(sel, t0, t1):
+    return q(f"sum({sel}) - (sum({sel} @ {t0}) or vector(0))", t1)
+
+
+def psi_max(sel, t0, t1, by):
+    w = int(t1) - int(t0)
+    return q(f"max(max_over_time((max by ({by}) (rate({sel}[1m])))[{w}s:15s])) * 100", t1)
+
+
+def psi_mean(sel, t0, t1, by):
+    w = int(t1) - int(t0)
+    return q(f"avg(avg_over_time((sum by ({by}) (rate({sel}[1m])))[{w}s:15s])) * 100", t1)
+
+
+bind = 'ate_scheduler_assignment_duration_seconds_bucket{ate_scheduler_outcome="assigned"}'
+restore = 'ate_actor_restore_duration_seconds_bucket{ate_snapshot_phase="total"}'
+restore_local = 'ate_actor_restore_duration_seconds_bucket{ate_snapshot_phase="total",ate_snapshot_kind="local"}'
+restore_latest = 'ate_actor_restore_duration_seconds_bucket{ate_snapshot_phase="total",ate_snapshot_kind="latest"}'
+crashes = "ate_actor_crashes_total"
+restores_n = 'ate_actor_restore_duration_seconds_count{ate_snapshot_phase="total"}'
+node_psi = 'container_pressure_cpu_waiting_seconds_total{container="node",kubernetes_io_hostname=~".*substrate-node-pool.*"}'
+pod_psi = ('container_pressure_cpu_waiting_seconds_total{namespace="benchmark-workloads",container="",'
+           'pod=~"pool-.*"}')
+
+cols = ["scenario", "pattern", "policy", "seed", "atespace", "t_start", "t_end",
+        "bind_p50_ms", "bind_p99_ms", "restore_p50_ms", "restore_p99_ms",
+        "restore_local_p99_ms", "restore_latest_p99_ms", "restores",
+        "crashes_metric", "node_psi_cpu_max_pct", "node_psi_cpu_mean_pct", "pod_psi_cpu_max_pct"]
+
+done = set()
+mpath = os.path.join(out, "metrics.csv")
+if os.path.exists(mpath):
+    with open(mpath) as f:
+        for r in csv.DictReader(f):
+            done.add((r["atespace"], r["t_start"]))
+
+with open(os.path.join(out, "retries.csv")) as f:
+    rows = list(csv.DictReader(f))
+
+new = not os.path.exists(mpath)
+with open(mpath, "a", newline="") as f:
+    w = csv.writer(f)
+    if new:
+        w.writerow(cols)
+    for r in rows:
+        if (r["atespace"], r["t_start"]) in done:
+            continue
+        t0, t1 = r["t_start"], r["t_end"]
+        if math.isnan(count(restores_n, t0, t1)):
+            raise RuntimeError(f"no restore samples for {r['atespace']}; is Prometheus reachable?")
+        ms = lambda x: round(x * 1000, 2)
+        rec = [r["scenario"], r["pattern"], r["policy"], r["seed"], r["atespace"], t0, t1,
+               ms(hq(0.5, bind, t0, t1)), ms(hq(0.99, bind, t0, t1)),
+               ms(hq(0.5, restore, t0, t1)), ms(hq(0.99, restore, t0, t1)),
+               ms(hq(0.99, restore_local, t0, t1)), ms(hq(0.99, restore_latest, t0, t1)),
+               count(restores_n, t0, t1), count(crashes, t0, t1),
+               round(psi_max(node_psi, t0, t1, "kubernetes_io_hostname"), 2),
+               round(psi_mean(node_psi, t0, t1, "kubernetes_io_hostname"), 2),
+               round(psi_max(pod_psi, t0, t1, "pod"), 2)]
+        w.writerow(rec)
+        print(dict(zip(cols, rec)))
diff --git a/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/summarize.py b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/summarize.py
new file mode 100644
index 000000000..4cfdd013d
--- /dev/null
+++ b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/summarize.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Joins retries.csv, runs.csv and metrics.csv per run and prints a per-cell table.
+
+usage: summarize.py OUT_DIR
+"""
+import csv
+import math
+import os
+import statistics
+import sys
+from collections import defaultdict
+
+out = sys.argv[1]
+
+
+def load(name):
+    p = os.path.join(out, name)
+    return list(csv.DictReader(open(p))) if os.path.exists(p) else []
+
+
+key = lambda r: (r["pattern"], r["policy"], r["seed"])
+runs = {key(r): r for r in load("runs.csv")}
+mets = {key(r): r for r in load("metrics.csv")}
+# Runs whose log stream ended early but whose counts were re-read from Cloud
+# Logging over the same window and matched.
+verified = {r["atespace"] for r in load("stream_verified.csv")}
+rows = []
+for r in load("retries.csv"):
+    k = key(r)
+    if r["pattern"] == "smoke" or k not in runs:
+        continue
+    ru, me = runs[k], mets.get(k, {})
+    f = lambda d, c: float(d.get(c, "nan") or "nan")
+    resumes = f(ru, "resumes")
+    crashes_m = f(me, "crashes_metric")
+    valid = (f(ru, "other_errors") == 0 and (r["stream_ok"] == "yes" or r["atespace"] in verified) and r["ate_system_restarts"] == "0")
+    rows.append({
+        "pattern": r["pattern"], "policy": r["policy"], "seed": r["seed"], "atespace": r["atespace"],
+        "valid": valid, "resumes": resumes, "unplaced": resumes - f(ru, "placed"),
+        "retries_per_resume": int(r["filled_up"]) / resumes if resumes else math.nan,
+        "filled_up": int(r["filled_up"]), "version_conflict": int(r["version_conflict"]),
+        "detaches": int(r["detaches"]), "crashes_log": int(r["crashes_log"]),
+        "crashes_metric": 0.0 if math.isnan(crashes_m) else crashes_m,
+        "ttp_p50": f(ru, "ttp_p50_ms"), "ttp_p99": f(ru, "ttp_p99_ms"),
+        "bind_p99": f(me, "bind_p99_ms"), "restore_p50": f(me, "restore_p50_ms"),
+        "restore_p99": f(me, "restore_p99_ms"),
+        "empty60": f(ru, "empty_drop_60"), "empty180": f(ru, "empty_drop_180"), "empty480": f(ru, "empty_drop_480"),
+        "psi_max": f(me, "node_psi_cpu_max_pct"), "psi_mean": f(me, "node_psi_cpu_mean_pct"),
+    })
+
+cols = ["pattern", "policy", "seed", "valid", "resumes", "unplaced", "retries_per_resume", "detaches",
+        "crashes_log", "crashes_metric", "ttp_p50", "ttp_p99", "bind_p99", "restore_p50", "restore_p99",
+        "empty60", "empty180", "empty480", "psi_max", "psi_mean"]
+
+
+def fmt(v):
+    if isinstance(v, bool):
+        return "yes" if v else "NO"
+    if isinstance(v, float):
+        if math.isnan(v):
+            return "-"
+        return f"{v:.4f}" if abs(v) < 1 and v != 0 else f"{v:.1f}" if v % 1 else f"{int(v)}"
+    return str(v)
+
+
+print("\t".join(cols))
+for r in sorted(rows, key=lambda r: (r["pattern"], r["policy"], r["seed"])):
+    print("\t".join(fmt(r[c]) for c in cols))
+
+print("\nmedians over valid runs (values per run in parens)")
+g = defaultdict(list)
+for r in rows:
+    if r["valid"]:
+        g[(r["pattern"], r["policy"])].append(r)
+for (p, pol), rs in sorted(g.items()):
+    def m(c):
+        vals = [r[c] for r in rs if not math.isnan(r[c])]
+        if not vals:
+            return "-"
+        return f"{fmt(float(statistics.median(vals)))} ({', '.join(fmt(float(v)) for v in vals)})"
+    print(f"{p:10s} {pol:16s} n={len(rs)} retries/resume={m('retries_per_resume')} ttp_p50={m('ttp_p50')} "
+          f"ttp_p99={m('ttp_p99')} bind_p99={m('bind_p99')} restore_p99={m('restore_p99')} "
+          f"crashes={m('crashes_metric')} detaches={m('detaches')} empty480={m('empty480')} psi_max={m('psi_max')}")
diff --git a/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/report_tables.py b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/report_tables.py
new file mode 100644
index 000000000..f2e1b6c83
--- /dev/null
+++ b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/report_tables.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Prints the results-gke.md pattern tables from the phase-b and phase-b-70 CSVs.
+
+Each cell shows the median of its valid runs, then every valid run in parens.
+usage: report_tables.py
+"""
+import csv
+import math
+import os
+import statistics
+from collections import defaultdict
+
+G = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+TOPOS = [("g-gke8", "phase-b", "~90% peak"), ("g-gke8-70", "phase-b-70", "~70% peak")]
+POLICIES = [("p2c", "p2c"), ("bestofd:3", "bestofd-3"), ("prefixsat:1:0.2", "prefixsat")]
+
+
+def load(d, name):
+    p = os.path.join(G, d, name)
+    return list(csv.DictReader(open(p))) if os.path.exists(p) else []
+
+
+def rows_for(d):
+    key = lambda r: (r["pattern"], r["policy"], r["seed"])
+    runs = {key(r): r for r in load(d, "runs.csv")}
+    mets = {key(r): r for r in load(d, "metrics.csv")}
+    verified = {r["atespace"] for r in load(d, "stream_verified.csv")}
+    out = []
+    for r in load(d, "retries.csv"):
+        k = key(r)
+        if r["pattern"] == "smoke" or k not in runs:
+            continue
+        ru, me = runs[k], mets.get(k, {})
+        f = lambda dd, c: float(dd.get(c, "nan") or "nan")
+        valid = (f(ru, "other_errors") == 0 and r["ate_system_restarts"] == "0"
+                 and (r["stream_ok"] == "yes" or r["atespace"] in verified))
+        res = f(ru, "resumes")
+        cm = f(me, "crashes_metric")
+        out.append(dict(pattern=r["pattern"], policy=r["policy"], seed=r["seed"], valid=valid,
+                        atespace=r["atespace"],
+                        unplaced=res - f(ru, "placed"), rpr=int(r["filled_up"]) / res,
+                        det=float(r["detaches"]), crash=max(float(r["crashes_log"]), 0 if math.isnan(cm) else cm),
+                        bind=f(me, "bind_p99_ms"), p50=f(ru, "ttp_p50_ms"), p99=f(ru, "ttp_p99_ms"),
+                        rest=f(me, "restore_p99_ms"), e480=f(ru, "empty_drop_480"),
+                        psi=f(me, "node_psi_cpu_max_pct")))
+    return out
+
+
+def ms(v):
+    return f"{v/1000:.1f}s" if v >= 10000 else f"{v:.0f}"
+
+
+def cell(vals, kind):
+    if not vals:
+        return "not measured"
+    m = statistics.median(vals)
+    if kind == "rpr":
+        return f"{m:.4f} ({', '.join(f'{v:.4f}' for v in vals)})"
+    if kind == "ms":
+        return f"{ms(m)}ms ({', '.join(ms(v) for v in vals)})"
+    return f"{m:g} ({', '.join(f'{v:g}' for v in vals)})"
+
+
+cols = ["Topology", "Algorithm", "Placed", "Retries per resume", "Bind p99", "ResumeActor p50",
+        "ResumeActor p99", "Restore p99", "Crashes", "Detaches", "Empty +8 min"]
+
+for pattern in ["ramp-down", "burst"]:
+    table = []
+    star_rows = {}
+    for topo, d, label in TOPOS:
+        rows = [r for r in rows_for(d) if r["pattern"] == pattern and r["valid"]]
+        by = defaultdict(list)
+        for r in rows:
+            by[r["policy"]].append(r)
+        med = {p: {k: statistics.median([r[k] for r in by[p]]) for k in ("p99", "crash", "e480")}
+               for p, _ in POLICIES if by[p]}
+        base = med.get("p2c")
+        qual = []
+        for p, _ in POLICIES:
+            if p not in med or base is None:
+                continue
+            ok = (all(r["unplaced"] == 0 for r in by[p]) and med[p]["crash"] <= base["crash"]
+                  and med[p]["p99"] <= 1.5 * base["p99"])
+            if ok:
+                qual.append(p)
+        if qual:
+            if pattern == "ramp-down":
+                star = max(qual, key=lambda p: (med[p]["e480"], -med[p]["p99"]))
+            else:
+                star = min(qual, key=lambda p: med[p]["p99"])
+            star_rows[topo] = star
+        for i, (p, name) in enumerate(POLICIES):
+            rs = by[p]
+            unpl = sum(r["unplaced"] for r in rs)
+            mark = "★ " if star_rows.get(topo) == p else "  "
+            table.append([f"{topo} ({label})" if i == 0 else "", mark + name,
+                          "all" if unpl == 0 else f"{unpl:g} unplaced",
+                          cell([r["rpr"] for r in rs], "rpr"),
+                          cell([r["bind"] for r in rs if not math.isnan(r["bind"])], "ms"),
+                          cell([r["p50"] for r in rs], "ms"), cell([r["p99"] for r in rs], "ms"),
+                          cell([r["rest"] for r in rs if not math.isnan(r["rest"])], "ms"),
+                          cell([r["crash"] for r in rs], "n"), cell([r["det"] for r in rs], "n"),
+                          cell([r["e480"] for r in rs], "n") if pattern == "ramp-down" else "-"])
+        table.append(None)
+    widths = [max(len(c), *(len(r[i]) for r in table if r)) for i, c in enumerate(cols)]
+    sep = "─┼─".join("─" * w for w in widths)
+    print(f"## {pattern}\n\n```")
+    print(" │ ".join(c.ljust(w) for c, w in zip(cols, widths)))
+    print(sep)
+    for r in table[:-1]:
+        print(sep if r is None else " │ ".join(c.ljust(w) for c, w in zip(r, widths)))
+    print("```\n")
diff --git a/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/monitoring-gke.yaml b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/monitoring-gke.yaml
new file mode 100644
index 000000000..dafa1cb8d
--- /dev/null
+++ b/cmd/ateapi/internal/scheduling/schedsim/gke-results/tools/monitoring-gke.yaml
@@ -0,0 +1,826 @@
+# Copyright 2026 The Agent Substrate Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: benchmarking
+  labels:
+    # Admits the benchmark clients to the Substrate API through
+    # manifests/ate-install/ate-system-networkpolicies.yaml.
+    ate.dev/api-access: "true"
+---
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: prometheus
+  namespace: benchmarking
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: prometheus
+  namespace: benchmarking
+rules:
+- apiGroups: [""]
+  resources: ["nodes", "nodes/proxy", "services", "endpoints", "pods"]
+  verbs: ["get", "list", "watch"]
+- apiGroups: ["extensions", "networking.k8s.io"]
+  resources: ["ingresses"]
+  verbs: ["get", "list", "watch"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: prometheus
+  namespace: benchmarking
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: prometheus
+subjects:
+- kind: ServiceAccount
+  name: prometheus
+  namespace: benchmarking
+---
+# A node is a cluster-scoped resource. Thus the namespaced Role above cannot
+# give access to node discovery or to the kubelet proxy. The cadvisor scrape
+# job needs the two permissions.
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRole
+metadata:
+  name: prometheus-benchmarking-nodes
+rules:
+- apiGroups: [""]
+  resources: ["nodes", "nodes/proxy", "nodes/metrics"]
+  verbs: ["get", "list", "watch"]
+- nonResourceURLs: ["/metrics"]
+  verbs: ["get"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRoleBinding
+metadata:
+  name: prometheus-benchmarking-nodes
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: ClusterRole
+  name: prometheus-benchmarking-nodes
+subjects:
+- kind: ServiceAccount
+  name: prometheus
+  namespace: benchmarking
+---
+# The postgres-exporter job discovers pods in ate-system. A Role there would
+# go with the namespace, which every automated test deletes and recreates.
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRole
+metadata:
+  name: prometheus-benchmarking-pods
+rules:
+- apiGroups: [""]
+  resources: ["pods"]
+  verbs: ["get", "list", "watch"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRoleBinding
+metadata:
+  name: prometheus-benchmarking-pods
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: ClusterRole
+  name: prometheus-benchmarking-pods
+subjects:
+- kind: ServiceAccount
+  name: prometheus
+  namespace: benchmarking
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: prometheus-config
+  namespace: benchmarking
+data:
+  prometheus.yml: |
+    global:
+      scrape_interval: 10s
+    scrape_configs:
+      - job_name: 'kubernetes-pods'
+        kubernetes_sd_configs:
+          - role: pod
+            namespaces:
+              names:
+                - benchmarking
+        relabel_configs:
+          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
+            action: keep
+            regex: "true"
+          - source_labels: [__meta_kubernetes_pod_name]
+            action: replace
+            target_label: pod
+          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
+            action: replace
+            target_label: __metrics_path__
+            regex: (.+)
+          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
+            action: replace
+            regex: ([^:]+)(?::\d+)?;(\d+)
+            replacement: $1:$2
+            target_label: __address__
+
+      # Scheduler experiment: ate-api-server and atelet serve /metrics on the
+      # port their prometheus.io/port annotation names.
+      - job_name: 'ate-system-pods'
+        kubernetes_sd_configs:
+          - role: pod
+            namespaces:
+              names:
+                - ate-system
+        relabel_configs:
+          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
+            action: keep
+            regex: "true"
+          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
+            action: replace
+            regex: ([^:]+)(?::\d+)?;(\d+)
+            replacement: $1:$2
+            target_label: __address__
+          - source_labels: [__meta_kubernetes_pod_name]
+            target_label: pod
+          - source_labels: [__meta_kubernetes_pod_label_app]
+            target_label: app
+          - source_labels: [__meta_kubernetes_pod_node_name]
+            target_label: node
+
+      # The telemetry-meter gives its substrate_* counts on port 8889, which
+      # the annotation job above collects. It gives its own otelcol_* counters
+      # on port 8888. The annotation relabel can name only one port, thus
+      # scrape port 8888 here. When a service reports zero volume,
+      # otelcol_receiver_accepted_* shows the difference between "sent nothing"
+      # and "arrived nowhere".
+      - job_name: 'telemetry-meter-self'
+        kubernetes_sd_configs:
+          - role: pod
+            namespaces:
+              names:
+                - benchmarking
+        relabel_configs:
+          - source_labels:
+              - __meta_kubernetes_pod_label_app
+              - __meta_kubernetes_pod_container_port_number
+            action: keep
+            regex: telemetry-meter;8888
+          - source_labels: [__meta_kubernetes_pod_name]
+            action: replace
+            target_label: pod
+
+      # The locust pod annotates port 8000 for the Python locust process. The
+      # boomer-worker sidecar exposes its Prometheus metrics on port 8001, and
+      # so does boomer inside an automation runner Job.
+      - job_name: 'boomer-worker'
+        kubernetes_sd_configs:
+          - role: pod
+            namespaces:
+              names:
+                - benchmarking
+        relabel_configs:
+          - source_labels:
+              - __meta_kubernetes_pod_label_app
+              - __meta_kubernetes_pod_container_port_number
+            action: keep
+            regex: (locust|substrate-benchmark-runner);8001
+          - source_labels: [__meta_kubernetes_pod_name]
+            action: replace
+            target_label: pod
+
+      # The postgres_exporter sidecar that an automation test with a
+      # `controlPlane:` block adds to Postgres (benchmarking/automation/
+      # controlplane.py): connections by state, commits, cache hits, and
+      # pg_stat_statements.
+      - job_name: 'postgres-exporter'
+        kubernetes_sd_configs:
+          - role: pod
+            namespaces:
+              names:
+                - ate-system
+        relabel_configs:
+          - source_labels:
+              - __meta_kubernetes_pod_label_app
+              - __meta_kubernetes_pod_container_port_number
+            action: keep
+            regex: postgres;9187
+          - source_labels: [__meta_kubernetes_pod_name]
+            action: replace
+            target_label: pod
+
+      # The container memory directly from the cAdvisor endpoint of the
+      # kubelet. `kubectl top` reads metrics-server, which reports an average
+      # across its own window and hides short peaks.
+      # container_memory_working_set_bytes is the value that the OOM killer
+      # uses.
+      - job_name: 'kubernetes-cadvisor'
+        scheme: https
+        tls_config:
+          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
+          insecure_skip_verify: true
+        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
+        kubernetes_sd_configs:
+          - role: node
+        relabel_configs:
+          - action: labelmap
+            regex: __meta_kubernetes_node_label_(.+)
+          - target_label: __address__
+            replacement: kubernetes.default.svc:443
+          - source_labels: [__meta_kubernetes_node_name]
+            regex: (.+)
+            target_label: __metrics_path__
+            replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor
+        metric_relabel_configs:
+          # cAdvisor reports host-level root cgroup metrics (such as Linux kernel
+          # PSI pressure stall information) with id="/" and an empty container
+          # label. Relabel id="/" to container="node" before dropping empty
+          # container labels so host-level pressure and utilization are kept.
+          - source_labels: [id]
+            regex: ^/$
+            target_label: container
+            replacement: node
+          # cAdvisor sends a very large number of metrics. Keep only the
+          # metrics that the benchmarks read: kernel pressure stall (PSI),
+          # container network bandwidth, disk I/O, memory RSS/working-set,
+          # CPU utilization, CFS throttling, and OOM kill events.
+          - source_labels: [__name__]
+            action: keep
+            regex: container_((.*pressure.*)|network_(receive|transmit)_bytes_total|fs_(reads|writes)_bytes_total|memory_rss|memory_working_set_bytes|cpu_usage_seconds_total|cpu_cfs_.*|spec_memory_limit_bytes|oom_events_total)
+          # Drop the series that have an empty container label only for cumulative
+          # memory working set and CPU usage. cAdvisor gives a rollup for the whole
+          # pod cgroup next to the series for each container; keeping both counts
+          # the memory/CPU of each pod two times. Dropping empty container on other
+          # metrics (such as network or PSI) would drop valid pod/node stats.
+          - source_labels: [__name__, container]
+            action: drop
+            regex: container_(memory_working_set_bytes|cpu_usage_seconds_total);$
