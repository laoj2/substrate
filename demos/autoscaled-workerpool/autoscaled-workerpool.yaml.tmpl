# Worker pool for the autoscaled-workerpool demo. The HPA in hpa-kind.yaml
# scales it. The ActorTemplate is not a CRD: it lives in
# autoscaled-workerpool-template.yaml.tmpl and is created through the ate API
# with `kubectl ate create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-autoscaled-workerpool

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: counter
  namespace: ate-demo-autoscaled-workerpool
  labels:
    workload: counter-autoscaled
spec:
  # The HPA's minReplicas. The HPA sets this field once it runs.
  replicas: 2
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-gvisor
  sandboxClasses:
  - name: gvisor
  template:
    # A worker advertises its limits as capacity, less the memory it keeps
    # for itself. The CPU holds four actors of the size in
    # autoscaled-workerpool-template.yaml.tmpl, and the memory has room for
    # those four.
    resources:
      limits:
        cpu: "1"
        memory: 1280Mi
      requests:
        cpu: 250m
        memory: 1280Mi
