# The counter template of autoscaled-workerpool-template.yaml.tmpl with CPU
# limits of 900m, so one actor takes most of a worker. A worker with one
# small actor has no room for it.
metadata:
  atespace: ate-demo-autoscaled-workerpool
  name: counter-large
workerSelector:
  matchLabels:
    workload: counter-autoscaled
containers:
- name: counter
  image: ko://go.ate.dev/substrate/demos/counter
  command: ["/ko-app/counter"]
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 900
    memoryBytes: 268435456 # 256Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
